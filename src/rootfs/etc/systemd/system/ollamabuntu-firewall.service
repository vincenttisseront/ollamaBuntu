[Unit]
Description=OllamaBuntu - pare-feu (nftables, refus par défaut en entrée)
DefaultDependencies=no
Before=network-pre.target shutdown.target
Wants=network-pre.target
After=local-fs.target
Conflicts=shutdown.target
ConditionPathExists=/etc/ollamabuntu/firewall.nft
ConditionPathExists=/usr/sbin/nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/ollamabuntu/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/ollamabuntu/firewall.nft
ExecStop=-/usr/sbin/nft delete table inet ollamabuntu

[Install]
WantedBy=sysinit.target
